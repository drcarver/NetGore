<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Core.Views.LanguageTablePage"
             xmlns:coreviewmodel="clr-namespace:GoDungeon.Core.ViewModels;assembly=GoDungeon.Core"
             xmlns:tables="clr-namespace:GoDungeon.Core.Tables;assembly=GoDungeon.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="tables:AcrobaticsModifierTable"
             Title="{Binding ProperName}">

    <CollectionView ItemsSource="{Binding Table}"
                    SelectionMode="None">
        <CollectionView.Header>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="200,400">
                <Label Text="{Binding Description}" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.ColumnSpan="2" />
                <Label Text="Name" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="1" Grid.Column="0" />
                <Label Text="Description" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="1" Grid.Column="1" />
            </Grid>
        </CollectionView.Header>
        <!--This footer is for Pathfinder content-->
        <CollectionView.Footer>
            <Grid RowDefinitions="Auto,Auto,Auto">
                <Label Grid.Row="0" Text="" Margin="10,10,0,0" />
                <Label Grid.Row="1" Text="This content is from the url: https://www.d20pfsrd.com/skills/linguistics" 
                       Margin="10,10,0,0" />
                <Label Grid.Row="2" Text="
Copyright Notice: Pathfinder RPG Core Rulebook. Copyright 2009, Paizo Publishing, LLC; Author: Jason Bulmahn, based on material by Jonathan Tweet, Monte Cook, and Skip Williams."
                       Margin="10,10,0,0" />
            </Grid>
        </CollectionView.Footer>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="coreviewmodel:StandardTableEntryViewModel">
                <Grid BackgroundColor="PapayaWhip" ColumnDefinitions="200,400">
                    <Label Text="{Binding ProperName}" Margin="10,10,0,0" 
                           Grid.Column="0" HorizontalTextAlignment="Start"/>
                    <Label Text="{Binding  Description}" Margin="10,10,0,0"
                           Grid.Column="1" HorizontalTextAlignment="Start"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>