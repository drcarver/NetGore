<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Core.Views.AbilityModifierTablePage"
             xmlns:coreviewmodel="clr-namespace:GoDungeon.Core.ViewModels;assembly=GoDungeon.Core"
             xmlns:tables="clr-namespace:GoDungeon.Core.Tables;assembly=GoDungeon.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="tables:AbilityModifierTable"
             Title="{Binding ProperName}">

    <CollectionView ItemsSource="{Binding Table}"
                    BackgroundColor="PapayaWhip"
                    SelectionMode="None">
        <CollectionView.Header>
            <Grid ColumnSpacing="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Label Text="Ability Score" 
                        HorizontalOptions="CenterAndExpand"
                        Grid.Column="0" />
                <Label Text="Modifier" 
                       HorizontalOptions="CenterAndExpand" 
                       Grid.Column="1" />
            </Grid>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="coreviewmodel:AbilityBonusEntryViewModel">
                <Grid ColumnSpacing="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Label Text="{Binding Score}"
                           Grid.Column="0" 
                           HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding Modifier}" 
                           Grid.Column="1" 
                           HorizontalTextAlignment="Center"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>