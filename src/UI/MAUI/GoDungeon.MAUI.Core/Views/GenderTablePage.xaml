<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Core.Views.GenderTablePage"
             xmlns:coreviewmodel="clr-namespace:GoDungeon.Core.ViewModels;assembly=GoDungeon.Core"
             xmlns:tables="clr-namespace:GoDungeon.Core.Tables;assembly=GoDungeon.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="tables:GenderTable"
             Title="{Binding ProperName}">

    <CollectionView ItemsSource="{Binding Table}"
                    SelectionMode="None">
        <CollectionView.Header>
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="100,300">
                <Label Grid.ColumnSpan="2" Margin="10,10,0,0"
                       Text="{Binding Description}" HorizontalOptions="Start" />
                <Label Grid.Row="1" Grid.Column="0" Margin="10,10,0,0"
                       Text="Name" HorizontalOptions="Start" />
                <Label Grid.Row="1" Grid.Column="1" Margin="10,10,0,0"
                       Text="Description" HorizontalOptions="Start" />
            </Grid>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="coreviewmodel:NamedTableEntryViewModel">
                <Grid BackgroundColor="PapayaWhip">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Label Text="{Binding Name}" Margin="10,10,0,0" 
                           Grid.Column="0" HorizontalTextAlignment="Start"/>
                    <Label Text="{Binding Description}" Margin="10,10,0,0"
                           Grid.Column="1" HorizontalTextAlignment="Start"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>