<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Core.Views.ConflictTablePage"
             xmlns:coreviewmodel="clr-namespace:GoDungeon.Core.ViewModels;assembly=GoDungeon.Core"
             xmlns:viewmodel="clr-namespace:GoDungeon.Background.ViewModels;assembly=GoDungeon.Background"
             xmlns:tables="clr-namespace:GoDungeon.Core.Tables;assembly=GoDungeon.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="tables:RandomTable"
             Title="{Binding ProperName}">

    <CollectionView ItemsSource="{Binding Table}"
                    SelectionMode="None">
        <CollectionView.Header>
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="100,300,100,400">
                <Label Text="{Binding Description}" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="0" Grid.Column="0"
                       Grid.ColumnSpan="4" />
                <Label Text="Dice" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="1" Grid.Column="0" />
                <Label Text="{Binding Dice}" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="1" Grid.Column="1"
                       Grid.ColumnSpan="2" />
                <Label Text="Range" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="2" Grid.Column="0" />
                <Label Text="Name" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="2" Grid.Column="1" />
                <Label Text="Conflict Points" Margin="10,10,0,0" 
                       HorizontalOptions="Center" 
                       Grid.Row="2" Grid.Column="2" />
                <Label Text="Description" Margin="10,10,0,0" 
                       HorizontalOptions="Start" 
                       Grid.Row="2" Grid.Column="3" />
            </Grid>
        </CollectionView.Header>
        <!--This footer is for Pathfinder content-->
        <CollectionView.Footer>
            <Grid RowDefinitions="Auto,Auto,Auto">
                <Label Grid.Row="0" Text="" Margin="10,10,0,0" />
                <Label Grid.Row="1" Text="This content is from the url: https://www.d20pfsrd.com/basics-ability-scores/more-character-options/character-backgrounds/background-generator" 
                       Margin="10,10,0,0" />
                <Label Grid.Row="2" Text="
Copyright Notice: Pathfinder RPG Core Rulebook. Copyright 2009, Paizo Publishing, LLC; Author: Jason Bulmahn, based on material by Jonathan Tweet, Monte Cook, and Skip Williams."
                       Margin="10,10,0,0" />
            </Grid>
        </CollectionView.Footer>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="viewmodel:ConflictTableEntryViewModel">
                <Grid BackgroundColor="PapayaWhip" ColumnDefinitions="100,300,100,400">
                    <Label Text="{Binding Range}" Margin="10,10,0,0" 
                           Grid.Column="0" HorizontalTextAlignment="Start"/>
                    <Label Text="{Binding ProperName}" Margin="10,10,0,0" 
                           Grid.Column="1" HorizontalTextAlignment="Start"/>
                    <Label Text="{Binding  ConflictPoints}" Margin="10,10,0,0"
                           Grid.Column="2" HorizontalTextAlignment="Center"/>
                    <Label Text="{Binding  Description}" Margin="10,10,0,0"
                           Grid.Column="3" HorizontalTextAlignment="Start"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>