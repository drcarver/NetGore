<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Core.Views.CoreMenuTablePage"
             xmlns:viewmodel="clr-namespace:GoDungeon.MAUI.Core.ViewModels"
             xmlns:coreviewmodel="clr-namespace:GoDungeon.MAUI.Core.ViewModels;assembly=GoDungeon.MAUI.Core"
             xmlns:tables="clr-namespace:GoDungeon.MAUI.Core.Tables;assembly=GoDungeon.MAUI.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="coreviewmodel:MenuTable"
             Title="{Binding ProperName}">

    <CollectionView ItemsSource="{Binding Table}"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionMode="Single"
                    SelectionChangedCommand="{Binding SelectionChangedCommand}"
                    BackgroundColor="PapayaWhip"
                    x:DataType="coreviewmodel:MenuTable">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="coreviewmodel:GameNavigationEntryViewModel">
                <HorizontalStackLayout>
                    <Label Text="{Binding Description}" Margin="10,10,0,0" />
                </HorizontalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
