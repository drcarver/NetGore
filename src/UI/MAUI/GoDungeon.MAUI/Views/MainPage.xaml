<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Views.MainPage"
             xmlns:viewmodel="clr-namespace:GoDungeon.MAUI.ViewModels;assembly=GoDungeon.MAUI"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:MainViewModel"
             BackgroundColor="AntiqueWhite">

    <TableView Intent="Menu" Margin="10,0,0,0">
        <TableRoot>
            <TableSection>
                <TextCell Text="Adventuring"
                      Detail="Rules and information governing player equipment and downtime." 
                      Command="{Binding AdventuringCommand}" />
                <TextCell Text="Character"
                      Detail="Rules for managing movement and travel" />
            </TableSection>
        </TableRoot>
    </TableView>
</ContentPage>
