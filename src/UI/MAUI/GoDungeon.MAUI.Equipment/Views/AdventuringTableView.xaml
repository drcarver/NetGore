<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.Equipment.Views.AdventuringTableView"
             xmlns:viewmodel="clr-namespace:GoDungeon.MAUI.Equipment.ViewModels;assembly=GoDungeon.MAUI.Equipment"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:AdventuringTableViewModel"
             BackgroundColor="AntiqueWhite">

    <TableView Intent="Menu" Margin="10,0,0,0">
        <TableRoot>
            <TableSection>
                <TextCell Text="Between Adventures"
                      Detail="Rules and information governing player time between adventures (downtime)"
                      Command="{Binding BetweenAdventuresCommand}" />
                <TextCell Text="Movement"
                      Detail="Rules for managing movement and travel"
                      Command="{Binding MovementCommand}" />
            </TableSection>
        </TableRoot>
    </TableView>
</ContentPage>
