<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoDungeon.MAUI.PlayerCharacter.Views.CreatePlayerCharacterPage"
             xmlns:coreviewmodel="clr-namespace:GoDungeon.Core.ViewModels;assembly=GoDungeon.Core"
             xmlns:viewmodel="clr-namespace:GoDungeon.MAUI.PlayerCharacter.ViewModels;assembly=GoDungeon.MAUI.PlayerCharacter"
             xmlns:ability="clr-namespace:GoDungeon.Core.Abilities;assembly=GoDungeon.Core"
             xmlns:tables="clr-namespace:GoDungeon.Core.Tables;assembly=GoDungeon.Core"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="viewmodel:PlayerCharacterViewModel"
             Title="Dungeons &amp; Dragons">
    
    <Grid BackgroundColor="PapayaWhip" RowDefinitions="Auto,Auto,Auto" >
        <!--The header block (Player Name, Character Name, Level, Race, Class and Background)-->
        <HorizontalStackLayout>
            <Grid RowDefinitions="Auto,Auto" x:Name="LeftHeaderGrid"
                  Margin="10,10,10,10">
                <Label Text="Johnny" FontSize="Title" Grid.Row="0" 
                       BackgroundColor="LightGray"
                       Margin="10,10,10,10"/>
                <Label Text="Character Name" FontFamily="monospace"
                       Margin="10,10,10,10" Grid.Row="1" />
            </Grid>
            <Border StrokeShape="RoundRectangle 20,20,20,20"
                    StrokeThickness="5">
                <Grid x:Name="RightHeaderGrid" Margin="10,10,10,10"
                  RowDefinitions="Auto,20,Auto,20" RowSpacing="5" 
                  ColumnDefinitions="200,200,200" ColumnSpacing="10">
                    <!--Class and Level-->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0"
                            BackgroundColor="LightGray">
                        <Picker x:Name="ClassPicker" 
                            ItemsSource="{Binding ValidClassList}"
                            SelectedItem="{Binding SelectedClass}"
                            Grid.Row="0" Grid.Column="0"
                            HorizontalTextAlignment="Start"
                            FontSize="Body" />
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Label VerticalTextAlignment="Center" Grid.Column="0"
                                   Text="Level" HorizontalTextAlignment="Start" />
                            <Label Text="{Binding Path=Race.Level}" 
                                    Grid.Column="1" FontSize="Body" 
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="End" />
                        </Grid>
                    </HorizontalStackLayout>
                    <!--Character Class & Level Label-->
                    <Label VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start"
                           Grid.Row="1" Grid.Column="0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Class" FontSize="Body"
                                        TextColor="Blue"
                                        TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DisplayWebPageCommand}"
                                              CommandParameter="https://5thsrd.org/character/classes/" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text=" &amp; " FontSize="Body" />
                                <Span Text="Level" FontSize="Body"
                                        TextColor="Blue"
                                        TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DisplayWebPageCommand}"
                                              CommandParameter="https://5thsrd.org/rules/leveling_up/" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <!--Character Race-->
                    <Picker x:Name="RacePicker"
                        ItemsSource="{Binding ValidRaceList}"
                            SelectedItem="{Binding SelectedRace}"
                            Grid.Row="0" Grid.Column="1"
                            HorizontalTextAlignment="Start"
                            BackgroundColor="LightGray"
                            FontSize="Body" FontAttributes="Italic">
                        <Picker.Behaviors>
                            <toolkit:EventToCommandBehavior
                                EventName="SelectedIndexChanged"
                            Command="{Binding RaceSelectionChangedCommand}" />
                        </Picker.Behaviors>
                    </Picker>
                    <!--Character Race Label-->
                    <Label VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start"
                           Grid.Row="1" Grid.Column="1">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Race" FontSize="Body"
                                        TextColor="Blue"
                                        TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DisplayWebPageCommand}"
                                                CommandParameter="https://5thsrd.org/character/races/" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Picker x:Name="AlignmentPicker" 
                            ItemsSource="{Binding AlignmentList}"
                            SelectedItem="{Binding SelectedAlignment}"
                            Grid.Row="0" Grid.Column="2"
                            BackgroundColor="LightGray"
                            FontSize="Body" FontAttributes="Italic"/>
                    <!--Character Alignment Label-->
                    <Label VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Start"
                           Grid.Row="1" Grid.Column="2">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Alignment" FontSize="Body"
                                        TextColor="Blue"
                                        TextDecorations="Underline">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DisplayWebPageCommand}"
                                                CommandParameter="https://5thsrd.org/character/alignment/" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Background"  
                           Grid.Row="3" Grid.Column="0"
                           HorizontalTextAlignment="Start"
                           TextColor="Crimson"
                           FontSize="Body"
                           FontFamily="monospace"/>
                    <Label Text="{Binding Path=Race.ExperiencePoints}"  
                           Grid.Row="2" Grid.Column="1"
                           HorizontalTextAlignment="Start"
                           BackgroundColor="LightGray"
                           FontSize="Body" FontAttributes="Italic"/>
                    <Label Text="Experience Points"  
                           Grid.Row="3" Grid.Column="1"
                           HorizontalTextAlignment="Start"
                           TextColor="Crimson" FontSize="Body"
                           FontFamily="monospace"/>
                    <Label Text="Darrel"
                           Grid.Row="2" Grid.Column="2"
                           HorizontalTextAlignment="Start"
                           BackgroundColor="LightGray"
                           FontSize="Body" FontAttributes="Italic"/>
                    <Label Text="Player Name"
                           Grid.Row="3" Grid.Column="2"
                           HorizontalTextAlignment="Start"
                           TextColor="Crimson" FontSize="Body"
                           FontFamily="monospace"/>
                </Grid>
            </Border>
        </HorizontalStackLayout>
        <!--The Abilities Block -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,Auto,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="100,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          Margin="10,10,10,10">
                    <Border StrokeShape="RoundRectangle 20,20,20,20"
                        StrokeThickness="2" Grid.Column="0" BackgroundColor="LightGray">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <Border StrokeShape="RoundRectangle 20,20,20,20"
                                        StrokeThickness="2" Grid.Row="0" Margin="2,2,2,2">
                                    <Grid RowDefinitions="Auto,Auto" 
                                                BackgroundColor="AntiqueWhite">
                                        <Label  Text="{Binding Path=Race.Strength.Name}" 
                                                HorizontalTextAlignment="Center" />
                                    <Label  Grid.Row="1" 
                                                Text="{Binding Path=Race.Strength.Score}"
                                                FontSize="Large" 
                                                Margin="0,0,0,15"
                                                HorizontalTextAlignment="Center" />
                                        <Frame  Grid.Row="1" 
                                                BackgroundColor="LightGray" 
                                                VerticalOptions="End"
                                                HorizontalOptions="Center"
                                                HeightRequest="15"
                                                WidthRequest="20"
                                                IsClippedToBounds="True"
                                                CornerRadius="7">
                                        <!--Margin="0,10,0,5"-->
                                        <Frame.Shadow>
                                                <Shadow Brush="Black"
                                                    Offset="5,5"
                                                    Radius="40"
                                                    Opacity="0.8" />
                                            </Frame.Shadow>
                                            <Label Text="{Binding Path=Race.Strength.AbilityBonus}"
                                                   TextColor="Crimson" 
                                                   FontSize="Header"
                                                   HorizontalTextAlignment="Center" 
                                                   VerticalTextAlignment="Center"/>
                                    </Frame>
                                    </Grid>
                                </Border>
                                <Border StrokeShape="RoundRectangle 20,20,20,20"
                                        StrokeThickness="2" Grid.Row="1">
                                    <Grid RowDefinitions="Auto,Auto" 
                                                BackgroundColor="AntiqueWhite">
                                        <Label Text="{Binding Path=Race.Intelligence.Name}" 
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2" FontSize="Large" 
                                               Text="{Binding Path=Race.Intelligence.Score}" 
                                               HorizontalTextAlignment="Center"/>
                                        <Frame  Grid.Row="1" 
                                                    BackgroundColor="LightGray" 
                                                    VerticalOptions="EndAndExpand"
                                                    HorizontalOptions="Center"
                                                    HeightRequest="15"
                                                    WidthRequest="20"
                                                    Margin="10,0,10,0"
                                                    IsClippedToBounds="False"
                                                    CornerRadius="7">
                                            <Frame.Shadow>
                                                <Shadow Brush="Black"
                                                        Offset="5,5"
                                                        Radius="40"
                                                        Opacity="0.8" />
                                            </Frame.Shadow>
                                            <Label Text="{Binding Path=Race.Strength.AbilityBonus}"
                                                       TextColor="Crimson" />
                                            </Frame>
                                    </Grid>
                                </Border>
                                <Border StrokeShape="RoundRectangle 20,20,20,20"
                                        StrokeThickness="2" Grid.Row="2">
                                    <Grid RowDefinitions="Auto,Auto" 
                                            BackgroundColor="AntiqueWhite">
                                        <Label Text="{Binding Path=Race.Wisdom.Name}" 
                                               HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2" FontSize="Large" 
                                               Text="{Binding Path=Race.Wisdom.Score}" 
                                               HorizontalTextAlignment="Center"/>
                                        <Frame  Grid.Row="1" 
                                                    BackgroundColor="LightGray" 
                                                    VerticalOptions="EndAndExpand"
                                                    HorizontalOptions="Center"
                                                    HeightRequest="15"
                                                    WidthRequest="20"
                                                    Margin="10,0,10,0"
                                                    IsClippedToBounds="False"
                                                    CornerRadius="7">
                                            <Frame.Shadow>
                                                <Shadow Brush="Black"
                                                        Offset="5,5"
                                                        Radius="40"
                                                        Opacity="0.8" />
                                            </Frame.Shadow>
                                            <Label Text="{Binding Path=Race.Strength.AbilityBonus}"
                                                       TextColor="Crimson" />
                                        </Frame>
                                    </Grid>
                                </Border>
                                <Border StrokeShape="RoundRectangle 20,20,20,20"
                                        StrokeThickness="2" Grid.Row="3">
                                    <Grid   RowDefinitions="Auto,Auto" 
                                            BackgroundColor="AntiqueWhite">
                                        <Label Text="{Binding Path=Race.Dexterity.Name}" 
                                                  HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2" FontSize="Large" 
                                                  Text="{Binding Path=Race.Dexterity.Score}" 
                                                  HorizontalTextAlignment="Center"/>
                                        <Frame  Grid.Row="1" 
                                                    BackgroundColor="LightGray" 
                                                    VerticalOptions="EndAndExpand"
                                                    HorizontalOptions="Center"
                                                    HeightRequest="15"
                                                    WidthRequest="20"
                                                    Margin="10,0,10,0"
                                                    IsClippedToBounds="False"
                                                    CornerRadius="7">
                                            <Frame.Shadow>
                                                <Shadow Brush="Black"
                                                        Offset="5,5"
                                                        Radius="40"
                                                        Opacity="0.8" />
                                            </Frame.Shadow>
                                            <Label Text="{Binding Path=Race.Strength.AbilityBonus}"
                                                       TextColor="Crimson" />
                                        </Frame>
                                    </Grid>
                                </Border>
                                <Border StrokeShape="RoundRectangle 20,20,20,20"
                                        StrokeThickness="2" Grid.Row="4">
                                    <Grid RowDefinitions="Auto,Auto" 
                                          BackgroundColor="AntiqueWhite">
                                        <Label Text="{Binding Path=Race.Constitution.Name}" 
                                            HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2" FontSize="Large" 
                                            Text="{Binding Path=Race.Constitution.Score}" 
                                            HorizontalTextAlignment="Center"/>
                                </Grid>
                                </Border>
                                <Border StrokeShape="RoundRectangle 20,20,20,20"
                                        StrokeThickness="2" Grid.Row="5">
                                    <Grid RowDefinitions="Auto,Auto" 
                                          BackgroundColor="AntiqueWhite">
                                        <Label Text="{Binding Path=Race.Charisma.Name}" 
                                            HorizontalTextAlignment="Center" />
                                        <Label Grid.Row="2" FontSize="Large" 
                                            Text="{Binding Path=Race.Charisma.Score}" 
                                            HorizontalTextAlignment="Center"/>
                                </Grid>
                                </Border>
                            </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollView>
        <Button Grid.Row="2" Text="Roll Again" Command="{Binding ReRollCommand}" />
    </Grid>
</ContentPage>