<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NetGore.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NetGore"
    xmlns:admin="clr-namespace:NetGore.UI.Admin.Views;assembly=NetGore.UI.Admin"
    Shell.FlyoutBehavior="Disabled"
    Title="NetGore">

    <FlyoutItem Title="Home">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
    </FlyoutItem>
    <FlyoutItem Title="Table Detail">
        <Tab>
            <ShellContent ContentTemplate="{DataTemplate admin:GameTableDetailPage}" />
        </Tab>
    </FlyoutItem>

    <!--<ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />-->

</Shell>
