<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:viewmodel="clr-namespace:NetGore.UI.Admin.ViewModel"
             x:Class="NetGore.UI.Admin.Views.CharacterAdvancementDetailPage"
             x:DataType="viewmodel:CharacterAdvancementDetailViewModel"
             Title="{Binding ProperName}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="75*" />
        </Grid.ColumnDefinitions>
        <Label Text="Dice"
            VerticalTextAlignment="Start"
            HorizontalOptions="Start"
            Margin="10,10,10,10"
            Grid.Row="0" Grid.Column="0" />
        <Label Text="{Binding Dice}"
            VerticalTextAlignment="Start"
            HorizontalOptions="Start"
            Margin="10,10,10,10"
            Grid.Row="0" Grid.Column="1" />
        <Label Text="Description"
            VerticalTextAlignment="Start"
            HorizontalOptions="Start"
            Margin="10,10,10,10"
            Grid.Row="1" Grid.Column="0" />
        <Label Text="{Binding Description}"
            VerticalTextAlignment="Start"
            HorizontalOptions="Start"
            Margin="10,10,10,10"
            Grid.Row="1" Grid.Column="1" />

        <syncfusion:SfDataGrid x:Name="CharacterAdvancementGrid"
                ItemsSource="{Binding Table}"
                AutoGenerateColumnsMode="None"
                GridLinesVisibility="Both"
                SelectionMode="None"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                SelectedRow="{Binding SelectedItem}" >
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridTextColumn
                    MappingName="Level"
                    HeaderText="Level"
                    ColumnWidthMode="Auto"/>
                <syncfusion:DataGridTextColumn
                    MappingName="Range"
                    HeaderText="Experience Points"
                    ColumnWidthMode="Auto" />
                <syncfusion:DataGridTextColumn
                    MappingName="ProficiencyBonus"
                    HeaderText="Proficiency Bonus"
                    ColumnWidthMode="LastColumnFill"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <Button Text="Go Back" Grid.Row="3" 
                Margin="10,10,10,10"
                Grid.ColumnSpan="2" 
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Command="{Binding GobackCommand}" />
    </Grid>
    
    
</ContentPage>